<?xml version="1.0"?>
<!--
  ============================================================
  MODELO SDF — Traxxas Slash 4x4 VXL Ultimate (68277-4) + RPLidar C1
  
  PARÂMETROS DO DATASHEET OFICIAL (traxxas.com):
    Length:        568mm  = 0.568m
    Width (track): 296mm  = 0.296m  (front e rear track iguais)
    Height:        193mm  = 0.193m
    Wheelbase:     324mm  = 0.324m
    Tire diameter: 109.5mm → raio = 0.05475m
    Weight stock:  2.28kg
    Ground clearance: 47mm = 0.047m

  PARÂMETROS PENDENTES — medir fisicamente:
    [MEDIR_1] Altura do LiDAR (z): medir com régua -> 22
    [MEDIR_2] Ângulo máximo de esterço: medir com transferidor -> 
    [MEDIR_3] Massa total com eletrônicos: pesar o rover completo
    [MEDIR_4] Coeficiente de atrito: testar empiricamente
    

  Lidar no X: 54/2 + 1.5
  Lidar no Y: 24 total e o lidar no 14

  CORREÇÕES v2 (datasheet oficial):
    track_width:   0.255m  →  0.296m  (datasheet: 296mm)
    wheel_radius:  0.054m  →  0.05475m (datasheet: 109.5mm diâmetro)
    height:        0.158m  →  0.193m  (datasheet: 193mm)
    wheel_separation (joint): 0.1275m → 0.148m (296/2)
    kingpin_width: 0.212m  →  0.253m  (296 - 43mm de largura de roda)
  ============================================================
-->
<sdf version="1.8">
  <model name="traxxas">
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="base_link">
      <gz_frame_id>traxxas/base_link</gz_frame_id>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!-- [MEDIR_3] Massa total com eletrônicos -->
        <!-- stock 2.28kg + Raspberry ~0.1kg + LiDAR ~0.17kg + controladora ~0.1kg + bateria ~0.3kg = ~3.0kg -->
        <mass>8.0</mass>
        <!-- Inércia caixa 0.568 x 0.296 x 0.193, m=3.0kg -->
        <!-- Ixx=(1/12)*3.0*(0.193²+0.296²) = 0.0310 -->
        <!-- Iyy=(1/12)*3.0*(0.568²+0.193²) = 0.0903 -->
        <!-- Izz=(1/12)*3.0*(0.568²+0.296²) = 0.1027 -->
        <inertia>
          <ixx>0.0310</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0903</iyy>
          <iyz>0</iyz>
          <izz>0.1027</izz>
        </inertia>
      </inertial>

      <!-- Colisão baseada nas dimensões reais -->
      <collision name="traxxas/BaseCollision">
        <!-- z = ground_clearance + height/2 = 0.047 + 0.0965 = 0.1435 -->
        <pose>0 0 0.1435 0 0 0</pose>
        <geometry>
          <box>
            <size>0.568 0.296 0.193</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- [MEDIR_4] -->
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- ===== VISUAIS ===== -->

      <visual name="traxxas/CarroInteiroVisual">
        <pose>
        -0.35 -0.18 -0.1 1.5708 0 1.5708
        </pose>
        <geometry>
          <mesh>
            <uri>file:///home/lauraluna/ackermann_sim/src/ackermann-vehicle-gzsim-ros2/saye_description/models/traxxas/meshes/Traxxas_Nitro_Rustler.stl</uri>
            <scale>0.0015 0.0015 0.0015</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>


      <visual name="traxxas/LidarVisual">
        <pose>0.035 0.1 0.16 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.038</radius><length>0.040</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <!-- ===== SENSORES ===== -->

      <!-- IMU -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <topic>imu</topic>
        <imu>
          <enable_orientation>1</enable_orientation>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0.00075</bias_mean><bias_stddev>0.005</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0.00075</bias_mean><bias_stddev>0.005</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0.00075</bias_mean><bias_stddev>0.005</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.0075</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.0075</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.0075</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- RPLidar C1 — 2D, 360°, 10Hz, 0.1–12m -->
      <!-- [MEDIR_1] z=0.228 estimado — medir altura real -->
      <!-- type="gpu_lidar": testado type="lidar" (CPU) e o Gazebo Harmonic
           deste ambiente aceita a tag mas nao publica nada (sem implementacao
           funcional de lidar por CPU nesta versao) -- so gpu_lidar realmente
           funciona aqui. gpu_lidar renderiza a cena via Ogre2 (contra a malha
           visual, nao a colisao); terreno com <heightmap> trava esse
           pipeline de profundidade, mas um <mesh> comum funciona bem. -->
      <sensor name="rplidar_c1" type="gpu_lidar">
        <pose>0 0 0.228 0 0 0</pose>
        <lidar>
          <scan>
            <horizontal>
              <samples>2400</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <gz_frame_id>traxxas/base_link/rplidar_c1</gz_frame_id>
        <topic>scan</topic>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
      </sensor>

      <!-- ============================================================
     Intel RealSense D435 — Câmera RGB-D simulada
     Posição: frente do chassi, levemente elevada
     ============================================================ -->
      <sensor name="realsense_d435" type="rgbd_camera">
        <pose>0.284 0 0.120 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>realsense</topic>
        <gz_frame_id>traxxas/base_link/realsense_d435</gz_frame_id>
        <camera>
          <!-- RGB -->
          <horizontal_fov>1.5184</horizontal_fov>  <!-- 87° FOV da D435 -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <!-- Profundidade -->
          <clip>
            <near>0.105</near>   <!-- mínimo D435: 10.5cm -->
            <far>10.0</far>      <!-- máximo prático: 10m -->
          </clip>
          <depth_camera>
            <output>depths</output>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- Visual da RealSense D435 
      <visual name="realsense_visual">
        <pose>0.284 0 0.120 0 0 0</pose>
        <geometry>
          <box><size>0.090 0.025 0.025</size></box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      -->

    </link>

    <!-- ===== RODAS DIANTEIRAS ===== -->
    <!-- Traxxas: raio = 109.5mm/2 = 54.75mm, largura estimada ~43mm -->

    <link name="front_left_wheel_link">
      <pose relative_to="front_left_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000120</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000120</iyy><iyz>0</iyz>
          <izz>0.000225</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="traxxas/FrontLeftWheelVisual">
        <transparency>1</transparency>   
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.05475</radius><length>0.043</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="traxxas/FrontLeftWheelCollision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.05475</radius><length>0.043</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- [MEDIR_4] -->
              <mu>0.8</mu><mu2>1.2</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="front_left_wheel_steering_link">
      <pose relative_to="front_left_wheel_steering_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>0.000004</ixx><iyy>0.000004</iyy><izz>0.000004</izz></inertia>
      </inertial>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_wheel_steering_link</parent>
      <child>front_left_wheel_link</child>
      <pose relative_to="front_left_wheel_steering_joint">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ===== SUSPENSÃO DIANTEIRA ESQUERDA ===== -->
    <link name="front_left_suspension_link">
      <pose relative_to="front_left_suspension_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.000002</ixx><iyy>0.000002</iyy><izz>0.000002</izz></inertia>
      </inertial>
    </link>

    <joint name="front_left_suspension_joint" type="prismatic">
      <parent>base_link</parent>
      <child>front_left_suspension_link</child>
      <!-- x = wheelbase/2 = 0.162, y = track/2 = 0.148 -->
      <pose relative_to="base_link">0.162 0.148 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- [MEDIR_SUSP_1] curso do amortecedor real (Traxxas ~10-15mm) -->
          <lower>-0.015</lower>
          <upper>0.015</upper>
          <velocity>2.0</velocity>
          <effort>50</effort>
        </limit>
        <dynamics>
          <!-- [MEDIR_SUSP_2] calibrar com massa real por roda -->
          <damping>18.0</damping>
          <spring_stiffness>800</spring_stiffness>
          <spring_reference>0</spring_reference>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="front_left_wheel_steering_joint" type="revolute">
      <parent>front_left_suspension_link</parent>
      <child>front_left_wheel_steering_link</child>
      <pose relative_to="front_left_suspension_joint">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- [MEDIR_2] -->
          <lower>-0.5</lower><upper>0.5</upper>
          <velocity>1.0</velocity><effort>30</effort>
        </limit>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name="front_right_wheel_link">
      <pose relative_to="front_right_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000120</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000120</iyy><iyz>0</iyz>
          <izz>0.000225</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="traxxas/FrontRightWheelVisual">
        <transparency>1</transparency>
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.05475</radius><length>0.043</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="traxxas/FrontRightWheelCollision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.05475</radius><length>0.043</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>1.2</mu2><fdir1>0 0 1</fdir1></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="front_right_wheel_steering_link">
      <pose relative_to="front_right_wheel_steering_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>0.000004</ixx><iyy>0.000004</iyy><izz>0.000004</izz></inertia>
      </inertial>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_wheel_steering_link</parent>
      <child>front_right_wheel_link</child>
      <pose relative_to="front_right_wheel_steering_joint">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ===== SUSPENSÃO DIANTEIRA DIREITA ===== -->
    <link name="front_right_suspension_link">
      <pose relative_to="front_right_suspension_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.000002</ixx><iyy>0.000002</iyy><izz>0.000002</izz></inertia>
      </inertial>
    </link>

    <joint name="front_right_suspension_joint" type="prismatic">
      <parent>base_link</parent>
      <child>front_right_suspension_link</child>
      <!-- x = wheelbase/2 = 0.162, y = -track/2 = -0.148 -->
      <pose relative_to="base_link">0.162 -0.148 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- [MEDIR_SUSP_1] curso do amortecedor real (Traxxas ~10-15mm) -->
          <lower>-0.015</lower>
          <upper>0.015</upper>
          <velocity>2.0</velocity>
          <effort>50</effort>
        </limit>
        <dynamics>
          <!-- [MEDIR_SUSP_2] calibrar com massa real por roda -->
          <damping>18.0</damping>
          <spring_stiffness>800</spring_stiffness>
          <spring_reference>0</spring_reference>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="front_right_wheel_steering_joint" type="revolute">
      <parent>front_right_suspension_link</parent>
      <child>front_right_wheel_steering_link</child>
      <pose relative_to="front_right_suspension_joint">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5</lower><upper>0.5</upper>
          <velocity>1.0</velocity><effort>30</effort>
        </limit>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ===== RODAS TRASEIRAS ===== -->

    <link name="rear_right_wheel_link">
      <pose relative_to="rear_right_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000120</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000120</iyy><iyz>0</iyz>
          <izz>0.000225</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="traxxas/RearRightWheelVisual">
        <transparency>1</transparency>
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.05475</radius><length>0.043</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="traxxas/RearRightWheelCollision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.05475</radius><length>0.043</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>1.2</mu2><fdir1>0 0 1</fdir1></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ===== SUSPENSÃO TRASEIRA DIREITA ===== -->
    <link name="rear_right_suspension_link">
      <pose relative_to="rear_right_suspension_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.000002</ixx><iyy>0.000002</iyy><izz>0.000002</izz></inertia>
      </inertial>
    </link>

    <joint name="rear_right_suspension_joint" type="prismatic">
      <parent>base_link</parent>
      <child>rear_right_suspension_link</child>
      <!-- x = -wheelbase/2 = -0.162, y = -track/2 = -0.148 -->
      <pose relative_to="base_link">-0.162 -0.148 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- [MEDIR_SUSP_1] curso do amortecedor real (Traxxas ~10-15mm) -->
          <lower>-0.015</lower>
          <upper>0.015</upper>
          <velocity>2.0</velocity>
          <effort>50</effort>
        </limit>
        <dynamics>
          <!-- [MEDIR_SUSP_2] calibrar com massa real por roda -->
          <damping>18.0</damping>
          <spring_stiffness>800</spring_stiffness>
          <spring_reference>0</spring_reference>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>rear_right_suspension_link</parent>
      <child>rear_right_wheel_link</child>
      <pose relative_to="rear_right_suspension_joint">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name="rear_left_wheel_link">
      <pose relative_to="rear_left_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000120</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000120</iyy><iyz>0</iyz>
          <izz>0.000225</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="traxxas/RearLeftWheelVisual">
        <transparency>1</transparency>
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.05475</radius><length>0.043</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="traxxas/RearLeftWheelCollision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.05475</radius><length>0.043</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>1.2</mu2><fdir1>0 0 1</fdir1></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ===== SUSPENSÃO TRASEIRA ESQUERDA ===== -->
    <link name="rear_left_suspension_link">
      <pose relative_to="rear_left_suspension_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.000002</ixx><iyy>0.000002</iyy><izz>0.000002</izz></inertia>
      </inertial>
    </link>

    <joint name="rear_left_suspension_joint" type="prismatic">
      <parent>base_link</parent>
      <child>rear_left_suspension_link</child>
      <!-- x = -wheelbase/2 = -0.162, y = track/2 = 0.148 -->
      <pose relative_to="base_link">-0.162 0.148 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- [MEDIR_SUSP_1] curso do amortecedor real (Traxxas ~10-15mm) -->
          <lower>-0.015</lower>
          <upper>0.015</upper>
          <velocity>2.0</velocity>
          <effort>50</effort>
        </limit>
        <dynamics>
          <!-- [MEDIR_SUSP_2] calibrar com massa real por roda -->
          <damping>18.0</damping>
          <spring_stiffness>800</spring_stiffness>
          <spring_reference>0</spring_reference>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>rear_left_suspension_link</parent>
      <child>rear_left_wheel_link</child>
      <pose relative_to="rear_left_suspension_joint">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ===== PLUGIN ACKERMANN ===== -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
      <!-- kingpin = track - wheel_width = 0.296 - 0.043 = 0.253 -->
      <kingpin_width>0.253</kingpin_width>
      <!-- [MEDIR_2] -->
      <steering_limit>0.5</steering_limit>
      <wheel_base>0.324</wheel_base>
      <wheel_separation>0.296</wheel_separation>
      <wheel_radius>0.05475</wheel_radius>
      <min_velocity>-1.5</min_velocity>
      <max_velocity>1.5</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
      <topic>/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>traxxas</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <!-- publish_link_pose desligado: publicava world -> traxxas/base_link,
           conflitando com odom -> traxxas do gz-sim-odometry-publisher-system
           (dois pais diferentes para o mesmo frame). A ligação entre "traxxas"
           e "traxxas/base_link" agora é feita por uma static_transform_publisher
           em traxxas_spawn.launch.py; publish_sensor_pose continua ligando os
           sensores (LiDAR, RealSense) a traxxas/base_link normalmente. -->
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_model_pose>false</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>uarm_shoulder_pan_joint</joint_name>
      <topic>/model/traxxas/uarm/shoulder_pan</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>uarm_shoulder_lift_joint</joint_name>
      <topic>/model/traxxas/uarm/shoulder_lift</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>uarm_elbow_joint</joint_name>
      <topic>/model/traxxas/uarm/elbow</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>uarm_gripper_left_joint</joint_name>
      <topic>/model/traxxas/uarm/gripper_left</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>uarm_gripper_right_joint</joint_name>
      <topic>/model/traxxas/uarm/gripper_right</topic>
    </plugin>


    <!-- ============================================================
         CARROCINHA EMBUTIDA NO MODELO DO TRAXXAS
         ============================================================ -->

    <!-- Gancho no Traxxas -->
    <link name="hitch_link">
      <pose>-0.264 0.1 0.035 0 0 0</pose>
      <inertial>
      <!-- 
        massa_total_chassi_com_garra = 3.332 kg
        massa_chassi_puro = 1.132 kg → CM z=0
        massa_garra = 2.2 kg → CM z=+0.187m
        CM_total_z = (1.132×0 + 2.2×0.187) / 3.332 = 0.1234m
      -->
      <pose>0 0 0.1234 0 0 0</pose>
      <mass>0.15</mass>
      <!-- Inércias calculadas com massa 3.332kg -->
      <!-- Ixx=(1/12)*3.332*(0.09284²+0.1886²) = 0.02089 -->
      <!-- Iyy=(1/12)*3.332*(0.350²+0.09284²)  = 0.04323 -->
      <!-- Izz=(1/12)*3.332*(0.350²+0.1886²)   = 0.05231 -->
      <inertia>
        <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.00001</iyy><iyz>0</iyz>
        <izz>0.00001</izz>
      </inertia>
    </inertial>
      <visual name="hitch_ball_visual">
        <geometry>
          <sphere><radius>0.015</radius></sphere>
        </geometry>
        <material>
          <ambient>0.8 0.7 0.0 1</ambient>
          <diffuse>0.8 0.7 0.0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Junta fixa do gancho ao chassi do Traxxas -->
    <joint name="hitch_to_chassis" type="fixed">
      <parent>base_link</parent>
      <child>hitch_link</child>
    </joint>

    <!-- Chassi da carrocinha -->
    <link name="trailer_base">
      <pose relative_to="hitch_link">-0.283 0 0 0 0 0</pose>
      <inertial>
        <mass>2.00</mass>
        <pose>0 0 0.05 0 0 0</pose>
        <inertia>
          <ixx>0.00737</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.02185</iyy><iyz>0</iyz>
          <izz>0.02636</izz>
        </inertia>
      </inertial>
      <collision name="trailer_base_collision">
        <geometry>
          <box><size>0.350 0.1886 0.09284</size></box>
        </geometry>
      </collision>
      <visual name="trailer_base_visual">
        <pose>-0.2 0.05 -0.1 -1.5707 0 3.1</pose>
        <geometry>
          <mesh>
            <uri>file:///home/lauraluna/ackermann_sim/src/ackermann-vehicle-gzsim-ros2/saye_description/models/traxxas/meshes/Reboque(sem_roda).stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- Haste de engate -->
      <visual name="hitch_bar_visual">
        <pose>0.229 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.108 0.020 0.015</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- ============================================================
     uArm Swift Pro — Visual estático (posição fechada, em pé)
     Dimensões: 150x140x281mm, massa: 2.2kg
     Posição: centro da carrocinha, na base
     ============================================================ -->

      <!-- ============================================================
     uArm Swift Pro — Visual estático (posição fechada, em pé)
     Dimensões: 150x140x281mm, massa: 2.2kg
     Posição: centro da carrocinha, na base
     ============================================================ -->
      <!-- uArm Swift Pro — mesh visual -->
      <visual name="uarm_visual">
        <pose>-0.08 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/lauraluna/ackermann_sim/src/ackermann-vehicle-gzsim-ros2/saye_description/models/traxxas/meshes/uarm.stl</uri>
            <scale>0.006 0.006 0.006</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
    </link> 

    
    

    
    <!-- Junta de engate — permite rotação em Z nas curvas -->
    <joint name="trailer_hitch_joint" type="universal">
      <parent>hitch_link</parent>
      <child>trailer_base</child>
      <pose relative_to="hitch_link">0 0 0 0 0 0</pose>
      <!-- Eixo 1: rotação em Z (vira para os lados nas curvas) -->
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.785</lower>
          <upper>0.785</upper>
          <effort>100</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>0.5</friction>
        </dynamics>
      </axis>
      <!-- Eixo 2: rotação em Y (sobe/desce independente do Traxxas) -->
      <axis2>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.3</lower>
          <upper>0.3</upper>
          <effort>100</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>0.5</friction>
        </dynamics>
      </axis2>
    </joint>
  
    <!-- Roda esquerda da carrocinha -->
    <link name="trailer_wheel_left">
      <pose relative_to="trailer_base">0 0.110 -0.03254 0 0 0</pose>
      <inertial>
        <mass>0.334</mass>
        <inertia>
          <ixx>0.000584</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000584</iyy><iyz>0</iyz>
          <izz>0.000818</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="trailer_wheel_left_visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.070</radius><length>0.030</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="trailer_wheel_left_collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.070</radius><length>0.030</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>1.2</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="trailer_wheel_left_joint" type="continuous">
      <parent>trailer_base</parent>
      <child>trailer_wheel_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics><damping>0.01</damping><friction>0.1</friction></dynamics>
      </axis>
    </joint>

    <!-- Roda direita da carrocinha -->
    <link name="trailer_wheel_right">
      <pose relative_to="trailer_base">0 -0.110 -0.03254 0 0 0</pose>
      <inertial>
        <mass>0.334</mass>
        <inertia>
          <ixx>0.000584</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000584</iyy><iyz>0</iyz>
          <izz>0.000818</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="trailer_wheel_right_visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.070</radius><length>0.030</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="trailer_wheel_right_collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.070</radius><length>0.030</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>1.2</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="trailer_wheel_right_joint" type="continuous">
      <parent>trailer_base</parent>
      <child>trailer_wheel_right</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics><damping>0.01</damping><friction>0.1</friction></dynamics>
      </axis>
    </joint>

  </model>
</sdf>