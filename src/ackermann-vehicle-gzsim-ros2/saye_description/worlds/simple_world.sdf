<?xml version="1.0"?>
<sdf version="1.8">
  <world name="beach_world">
    <!-- Plugins do Sistema da Simulação -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Plugin para gerenciar animações/movimentos dinâmicos -->
    <plugin filename="gz-sim-trajectory-follower-system" name="gz::sim::systems::TrajectoryFollower"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.8 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Terreno arenoso com relevo real (dune_terrain.obj, gerado localmente),
         mas SO no visual. A colisao continua um plano perfeitamente liso de
         proposito: a geometria <heightmap> foi testada e trava o
         renderizador de profundidade (Ogre2) sempre que o LiDAR (gpu_lidar)
         ou a camera RealSense (rgbd_camera, saida de profundidade) tentam
         renderizar uma cena com heightfield neste ambiente ;e isso vale
         tanto pra heightmap de colisao quanto de puro visual, pois o
         problema e o material/shader de terreno, nao a fisica. Um mesh comum
         (.obj) nao usa esse shader especial e renderiza normalmente, como
         qualquer outro modelo do projeto (carroceria, reboque, letras).
         Efeito colateral aceito: fisicamente o chao e plano, entao o robo
         nao "sente" as dunas na suspensao ;e so aparencia. Se um dia for
         preciso relevo fisico de verdade, ver nota mais abaixo sobre
         segmentacao de chao via nuvem de pontos da RealSense. -->
    <model name="sandy_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/lauraluna/ackermann_sim/src/ackermann-vehicle-gzsim-ros2/saye_description/worlds/media/dune_terrain.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.76 0.69 0.50 1</ambient>
            <diffuse>0.80 0.72 0.52 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- PESSOAS DETECTAVEIS (Fase 4.0; multiplas e variadas na 4.6):
         aparencia DIFERENTE pra cada uma (necessario pra validar a
         associacao/rastreamento de verdade). NENHUMA e um <actor>.

         ACHADO IMPORTANTE (Fase 4.6, pesquisa a fundo motivada por um
         pedido explicito de usar atores com animacao de caminhada via
         github.com/blackcoffeerobotics/gazebo-ros-actor-plugin): atores
         NAO SAO UMA OPCAO NESTE PROJETO - causa raiz isolada com precisao:
           1. Testado com o skin exato daquele repositorio (DoctorFemaleWalk)
              - invisivel numa camera "camera" comum de perto (1.5m).
           2. Numa camera "camera" comum mais longe (3m+) o ator RENDERIZA
              normalmente - nao e "atores nunca renderizam".
           3. O problema real: nem `rgbd_camera` nem `depth_camera` (os
              DOIS tipos que geram profundidade) renderizam o ator, em
              nenhuma distancia - so a `camera` RGB pura consegue.
           4. Consequencia: mesmo se o YOLO detectasse um ator na imagem
              RGB, o `projecao3d_node` nunca acharia profundidade valida -
              a deteccao seria sempre descartada.

         SOLUCAO (ainda sem <actor>, mas com caminhada DE VERDADE): as
         pessoas 1 e 2 sao um "flipbook" de 29 e 27 malhas estaticas
         (`pessoa_andando_N_frame_<k>`, um por keyframe do ciclo original) - poses reais extraidas do
         esqueleto original de um ator (skinning manual, script
         `saye_tracking` de bake - ver README da Fase 4.6), nao uma unica
         pose deslizando. `mover_pessoa_animada_node.py` troca qual quadro
         fica visivel (teleporta o ativo pra posicao real, estaciona os
         outros em z=-50) com base na DISTANCIA percorrida - da pra ver as
         pernas alternando de verdade. A pessoa 3 usa o mecanismo mais
         simples da 4.5 (uma pose so, "Scrubs"), suficiente como 3o alvo. -->
    <!-- ========================================== -->
    <include>
      <uri>model://saye_description/models/pessoa_andando_1_frame_0</uri>
      <name>pessoa_andando_1_frame_0</name>
      <pose>2.0 0.0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
