<?xml version="1.0"?>
<sdf version="1.8">
  <world name="beach_world">
    <!-- Plugins do Sistema da Simulação -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Plugin para gerenciar animações/movimentos dinâmicos -->
    <plugin filename="gz-sim-trajectory-follower-system" name="gz::sim::systems::TrajectoryFollower"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.8 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Terreno arenoso com relevo real (dune_terrain.obj, gerado localmente),
         mas SO no visual. A colisao continua um plano perfeitamente liso de
         proposito: a geometria <heightmap> foi testada e trava o
         renderizador de profundidade (Ogre2) sempre que o LiDAR (gpu_lidar)
         ou a camera RealSense (rgbd_camera, saida de profundidade) tentam
         renderizar uma cena com heightfield neste ambiente ;e isso vale
         tanto pra heightmap de colisao quanto de puro visual, pois o
         problema e o material/shader de terreno, nao a fisica. Um mesh comum
         (.obj) nao usa esse shader especial e renderiza normalmente, como
         qualquer outro modelo do projeto (carroceria, reboque, letras).
         Efeito colateral aceito: fisicamente o chao e plano, entao o robo
         nao "sente" as dunas na suspensao ;e so aparencia. Se um dia for
         preciso relevo fisico de verdade, ver nota mais abaixo sobre
         segmentacao de chao via nuvem de pontos da RealSense. -->
    <model name="sandy_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/lauraluna/ackermann_sim/src/ackermann-vehicle-gzsim-ros2/saye_description/worlds/media/dune_terrain.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.76 0.69 0.50 1</ambient>
            <diffuse>0.80 0.72 0.52 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- PESSOA DETECTAVEL (Fase 4, submodulo 4.0): malha do Gazebo Fuel
         "Standing person" (MakeHuman, textura real - YOLOv8 detecta como
         "person" com ~0.93 de confianca no teste isolado). NAO e um
         <actor> - o sistema de ator do Gazebo nao renderiza pra camera de
         sensor nesta maquina (testado e confirmado isolado).

         TENTATIVA DESCARTADA (registrada aqui pra nao repetir): mover ela
         com o plugin TrajectoryFollower (forca/torque fisicos), igual aos
         3 obstaculos dinamicos abaixo. Diferente deles (baixos e
         simetricos - esfera/caixa/cilindro), um corpo ALTO com centro de
         massa a quase 1m do chao TOMBA sob forca/torque bruto sem
         amortecimento - testado com varias combinacoes de forca, torque,
         tamanho de base e inercia rotacional (ate 20x maior que o valor
         real), sempre ou tombava ou saia deslizando sem controle. Virou
         um problema de modelagem fisica (precisaria de uma junta
         restringindo so o eixo de guinada, tipo um "carrinho" por baixo),
         nao so de ajuste de parametro - abandonado em favor de mover ela
         CINEMATICAMENTE (teleporte direto via `/world/.../set_pose`, o
         mesmo servico usado pra resetar o robo na Fase 4.4), que nao tem
         fisica nenhuma envolvida e portanto nao tomba. Ver
         `saye_tracking/mover_pessoa_node.py`. Por isso ela continua
         <static>true</static> aqui - "estatica" pro solver de fisica, mas
         o teleporte externo ainda reposiciona ela livremente. -->
    <!-- ========================================== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>pessoa_detectavel</name>
      <pose>2.0 1.0 0 0 0 -1.5708</pose>
      <static>true</static>
    </include>

    <!-- Os 3 obstaculos dinamicos (esfera/caixa/cilindro) ficam comentados
         a partir de agora - a Fase 4 passou a trabalhar so com deteccao
         de "person", e esses obstaculos geometricos nao sao dessa classe
         (as vezes eram confundidos com "person" pelo YOLO por engano,
         poluindo as metricas - ver achado do 4.2/4.3 no README do
         saye_tracking). Mantidos aqui comentados (nao apagados) caso
         sejam uteis de novo numa fase futura (ex.: obstaculos genericos
         pro costmap dinamico da Fase 5).

    <model name="dynamic_obstacle_sphere">
      <pose>2.0 0.0 0.5 0 0 0</pose>
      <static>false</static>

      <plugin filename="gz-sim-trajectory-follower-system" name="gz::sim::systems::TrajectoryFollower">
        <link_name>link</link_name>
        <loop>true</loop>
        <force>15</force>
        <torque>15</torque>
        <waypoints>
          <waypoint>2.0 -3.0</waypoint>
          <waypoint>2.0 3.0</waypoint>
        </waypoints>
      </plugin>

      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.064</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.064</iyy><iyz>0</iyz>
            <izz>0.064</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.4</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.4</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name="dynamic_obstacle_box">
      <pose>5.0 2.0 0.5 0 0 0</pose>
      <static>false</static>

      <plugin filename="gz-sim-trajectory-follower-system" name="gz::sim::systems::TrajectoryFollower">
        <link_name>link</link_name>
        <loop>true</loop>
        <force>15</force>
        <torque>15</torque>
        <waypoints>
          <waypoint>3.0 2.0</waypoint>
          <waypoint>7.0 2.0</waypoint>
        </waypoints>
      </plugin>

      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.06</iyy><iyz>0</iyz>
            <izz>0.06</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.1 1</ambient>
            <diffuse>0.8 0.5 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.6</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name="dynamic_obstacle_cylinder">
      <pose>0.0 0.0 0.5 0 0 0</pose>
      <static>false</static>

      <plugin filename="gz-sim-trajectory-follower-system" name="gz::sim::systems::TrajectoryFollower">
        <link_name>link</link_name>
        <loop>true</loop>
        <force>15</force>
        <torque>15</torque>
        <waypoints>
          <waypoint>1.0 1.0</waypoint>
          <waypoint>4.0 1.0</waypoint>
          <waypoint>4.0 4.0</waypoint>
          <waypoint>1.0 4.0</waypoint>
        </waypoints>
      </plugin>

      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.0758</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0758</iyy><iyz>0</iyz>
            <izz>0.045</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.3</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.1 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.3</radius><length>0.8</length></cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
    -->

  </world>
</sdf>